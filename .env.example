# Copy to .env and fill from 1Password (plain values or op:// references).
# If you use op:// strings, run scripts via: npm run db:ping:op
#   (requires the 1Password CLI: https://developer.1password.com/docs/cli)

# --- SurrealDB (Surrealist / Surreal Cloud) ---
SURREAL_URL=wss://bright-phoenix-06e6tjdbmdp4b2ivpj6m0s0k0o.aws-usw2.surreal.cloud/rpc
SURREAL_NAMESPACE=main
SURREAL_DATABASE=main
# Must match a Root system user created in Surrealist → Authentication
SURREAL_USERNAME=root

# --- HashiCorp Vault (holds the SurrealDB password) ---
# Address of your Vault (no trailing slash required)
VAULT_ADDR=https://v.omega-agent.cloud

# Auth: provide VAULT_TOKEN *or* AppRole (VAULT_ROLE_ID + VAULT_SECRET_ID)
VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

# KV path as used by the Vault HTTP API (do NOT include a leading /v1/).
# KV v2 example: kv/data/surreal
# KV v1 example: secret/isomer/surreal
VAULT_SECRET_PATH=kv/data/surreal

# Field name inside that secret that stores the SurrealDB password
VAULT_SECRET_FIELD=password

# Optional: set VAULT_KV_VERSION=1 if the mount is KV v1 (default: auto-detect)
# VAULT_KV_VERSION=2
