{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/rubric.schema.json",
  "title": "MaturityRubric",
  "description": "Per-domain maturity rubric: five cumulative levels with observable criteria.",
  "type": "object",
  "required": ["domain", "version", "scoring", "levels"],
  "additionalProperties": false,
  "properties": {
    "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "scoring": { "enum": ["all-criteria-cumulative"] },
    "levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["level", "name", "descriptor", "observable_criteria"],
        "additionalProperties": false,
        "properties": {
          "level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
          "name": { "type": "string" },
          "descriptor": { "type": "string", "minLength": 20 },
          "observable_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 15 }
          }
        }
      }
    }
  }
}
