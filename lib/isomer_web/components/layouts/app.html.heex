<header class="isomer-app-header">
  <.container max_width="lg" class="relative flex items-center justify-between gap-4 py-3.5">
    <.brand_logo to={~p"/"} />
    <div
      id="sticky-page-title"
      class="isomer-sticky-title"
      hidden
      aria-hidden="true"
    >
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <.color_scheme_switch id="isomer-scheme" variant="dropdown" />
      <nav :if={assigns[:current_email]} class="flex items-center gap-2 sm:gap-3">
        <span class="hidden max-w-[14rem] truncate text-sm text-slate-500 dark:text-slate-400 sm:inline">
          {@current_email}
        </span>
        <.button
          link_type="live_redirect"
          to={~p"/orgs"}
          color="gray"
          variant="ghost"
          size="sm"
          label="Orgs"
        />
        <.button
          link_type="a"
          to={~p"/logout"}
          color="gray"
          variant="outline"
          size="sm"
          label="Sign out"
        />
      </nav>
    </div>
  </.container>
</header>
<main class="pb-16">
  <.container max_width="lg" class="py-8 sm:py-10">
    <.flash_group flash={@flash} />
    {@inner_content}
  </.container>
</main>
